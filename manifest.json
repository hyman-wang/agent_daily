{
  "manifest_version": 3,
  "name": "Agent Journal - Agent 日报周报助手",
  "version": "1.0.0",
  "description": "在本地自动记录你的 Agent 提问，生成可搜索、可导出的日报和周报。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://www.doubao.com/*",
    "https://yuanbao.tencent.com/*",
    "https://www.tongyi.com/*",
    "https://tongyi.aliyun.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Agent Journal",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.doubao.com/*",
        "https://yuanbao.tencent.com/*",
        "https://www.tongyi.com/*",
        "https://tongyi.aliyun.com/*"
      ],
      "js": ["lib/core.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
